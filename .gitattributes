# Ép toàn bộ các file này luôn dùng xuống dòng kiểu Unix (LF), kể cả khi checkout/edit trên Windows.
# Tránh lỗi "no build stage in current context" khi Docker đọc phải Dockerfile có CRLF.
* text=auto eol=lf

Dockerfile text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.conf text eol=lf
*.txt text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.joblib binary
*.pptx binary
*.docx binary
