# === Copy file này thành .env và điền giá trị thật. KHÔNG commit file .env ===

# --- AI Service ---
AI_SERVICE_PORT=8001

# --- Backend ---
BACKEND_PORT=8000
# Địa chỉ Backend gọi tới AI Service.
# Khi chạy trong docker-compose (local): dùng tên service, KHÔNG dùng localhost
AI_SERVICE_URL=http://ai-service:8001
# Khi AI Service public qua ngrok/tunnel hoặc deploy cloud, thay bằng địa chỉ đó, ví dụ:
# AI_SERVICE_URL=https://xxxx.ngrok-free.app

# MongoDB Atlas (lưu lịch sử dự đoán)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mushroom_db

# --- Frontend ---
FRONTEND_PORT=3000
# Địa chỉ Frontend gọi tới Backend. Khi public, thay bằng địa chỉ Backend đã deploy/tunnel
API_URL=http://localhost:8000
